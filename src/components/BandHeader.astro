---
/**
 * <BandHeader title eyebrow? lead? back? backLabel?> — the inner pages' marbled header band, as on the
 * original site: the purple texture under a dark veil, the page's ONLY <h1> in white serif, an optional
 * "← Back to all research" quiet link, and a slot at the bottom edge for the category tab row.
 * Two parallax layers measured from the top of the page: the texture runs ahead (-0.2), the text lingers (0.15),
 * clamped to the band's bottom padding so the lingering text is never clipped by the band's edge.
 * The text sits in a centred column (max 68ch).
 */
import Marble from './Marble.astro';
export interface Props { title: string; eyebrow?: string; lead?: string; back?: string; backLabel?: string; tabs?: boolean; wide?: boolean }
const { title, eyebrow, lead, back, backLabel = '← Back', tabs = false, wide = false } = Astro.props;
---
<div class={`page-header band-header marble marble--deep${tabs ? ' band-header--tabs' : ''}${wide ? ' band-header--wide' : ''}`}>
  <Marble parallax={-0.2} origin="top" max={200} />
  <div class="band-header__inner text-center" data-parallax="0.15" data-parallax-origin="top" data-parallax-max={tabs ? '24' : '40'}>
    {back && <a class="btn btn--quiet btn--small band-header__back" href={back}>{backLabel}</a>}
    {eyebrow && <p class="eyebrow reveal reveal--wipe">{eyebrow}</p>}
    <h1 class="reveal-words" style="--reveal-delay: 100ms">{title}</h1>
    {lead && <p class="lead reveal reveal--blur" style="--reveal-delay: 350ms; --reveal-dur: 1000ms">{lead}</p>}
    <slot />
  </div>
</div>
