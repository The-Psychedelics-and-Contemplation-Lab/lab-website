---
import { Layout, Section } from '@pcl/design-system';
import BandHeader from '../../components/BandHeader.astro';
import { getCollection } from 'astro:content';
import { site, navFor } from '../../site.config';
import PublicationItem from '../../components/PublicationItem.astro';
import '../../styles/site.css';

/** Topic chips for the "Filter by topic" row below the Lab/All checkbox. Slugs must match the
 *  `tags` written into each entry of src/content/publications.json. Shown in this fixed order
 *  regardless of how many publications currently match each one. */
const TOPIC_TAGS = [
  { slug: 'psychedelics', label: 'Psychedelics' },
  { slug: 'ketamine', label: 'Ketamine' },
  { slug: 'meditation', label: 'Meditation & Mindfulness' },
  { slug: 'hypnosis', label: 'Hypnosis & Suggestion' },
  { slug: 'consciousness', label: 'Consciousness & Altered States' },
  { slug: 'context', label: 'Context, Placebo & Set and Setting' },
  { slug: 'mood', label: 'Mood, Anxiety & Trauma' },
  { slug: 'neuroscience', label: 'Neuroscience & Neuroimaging' },
  { slug: 'addiction', label: 'Addiction & Substance Use' },
  { slug: 'policy', label: 'Policy, Ethics & Equity' },
  { slug: 'aging', label: 'Aging & Neurodegeneration' },
  { slug: 'clinical', label: 'Clinical Practice & Health Systems' },
  { slug: 'nature', label: 'Nature, Art & Ecology' },
  { slug: 'methods', label: 'Methods & Measurement' },
] as const;

const pubs = (await getCollection('publications')).map((e) => e.data).sort((a, b) => a.order - b.order);
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a);
const coreCount = pubs.filter((p) => p.core).length;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Publications — The Psychedelics & Contemplation Lab',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  hasPart: pubs.map((p) => ({ '@type': 'ScholarlyArticle', headline: p.title, datePublished: String(p.year), author: p.authors, isPartOf: { '@type': 'Periodical', name: p.journal }, ...(p.doi ? { sameAs: `https://doi.org/${p.doi}` } : {}) })),
};
---
<Layout site={site} page={{ title: 'Publications — The Psychedelics & Contemplation Lab', description: `${coreCount} peer-reviewed publications co-authored by the lab's directors, ${years[years.length - 1]}–${years[0]}, on ketamine and psilocybin therapy, music, set and setting, and contemplative science.`, path: '/publications/', schema }} nav={navFor('/publications/')}>
  <main id="main">
    <BandHeader title="Publications" tabs>
      <nav aria-label="Jump to year">
        <ul class="tab-row reveal-group">{years.map((y) => <li><a href={`#y${y}`}>{y}</a></li>)}</ul>
      </nav>
    </BandHeader>
    <Section>
      <div class="pub-filter">
        <label class="pub-filter__check">
          <input type="checkbox" id="pub-show-all" />
          Show all publications from active lab members
        </label>
      </div>
      <div class="pub-topics">
        <p class="pub-topics__label" id="pub-topics-label">Filter by topic</p>
        <ul class="pub-topics__list" role="group" aria-labelledby="pub-topics-label">
          {TOPIC_TAGS.map((t) => (
            <li><button type="button" class="tag-chip" data-tag={t.slug} aria-pressed="false">{t.label}</button></li>
          ))}
        </ul>
        <button type="button" class="pub-topics__clear">Clear topics</button>
      </div>
      {years.map((y) => (
        <section class="year-group" id={`y${y}`} aria-labelledby={`y${y}-h`}>
          <h2 class="year-group__year reveal reveal--wipe" id={`y${y}-h`}>{y}</h2>
          <ul class="pub-list reveal-group">
            {pubs.filter((p) => p.year === y).map((pub) => <PublicationItem pub={pub} />)}
          </ul>
        </section>
      ))}
    </Section>
  </main>
</Layout>

<script>
  // Two independent filters narrow the list down together:
  //  - the "show all" checkbox: unchecked (default) keeps only publications with a lab director
  //    (Greenway or Lifshitz) as an author (PublicationItem marks each entry data-core="true|false");
  //    checked reveals every publication by current, active lab members.
  //  - the topic chips: each .pub carries a space-separated data-tags attribute. With no chip active,
  //    topic doesn't filter anything; with one or more active, a pub shows if it has at least one of
  //    the active tags (chips are OR'd together, not AND'd).
  // A year's heading and its jump-to-year nav link are hidden too whenever that year has nothing left
  // to show under the current combination of filters.
  const checkbox = document.querySelector<HTMLInputElement>('#pub-show-all');
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('.tag-chip[data-tag]')];
  const clearBtn = document.querySelector<HTMLButtonElement>('.pub-topics__clear');
  const topicsEl = document.querySelector<HTMLElement>('.pub-topics');
  const pubItems = [...document.querySelectorAll<HTMLElement>('.pub[data-core]')];
  const yearGroups = [...document.querySelectorAll<HTMLElement>('.year-group')];
  const yearNavLinks = [...document.querySelectorAll<HTMLAnchorElement>('[aria-label="Jump to year"] a')];

  const activeTags = new Set<string>();

  const applyView = () => {
    const showAll = checkbox?.checked ?? false;
    pubItems.forEach((item) => {
      const passesCore = showAll || item.dataset.core === 'true';
      const itemTags = (item.dataset.tags ?? '').split(' ').filter(Boolean);
      const passesTags = activeTags.size === 0 || itemTags.some((t) => activeTags.has(t));
      item.hidden = !(passesCore && passesTags);
    });
    yearGroups.forEach((group) => {
      const hasVisible = [...group.querySelectorAll<HTMLElement>('.pub')].some((p) => !p.hidden);
      group.hidden = !hasVisible;
      const link = yearNavLinks.find((a) => a.getAttribute('href') === `#${group.id}`);
      if (link?.parentElement) (link.parentElement as HTMLElement).hidden = !hasVisible;
    });
    topicsEl?.classList.toggle('has-active', activeTags.size > 0);
  };

  checkbox?.addEventListener('change', applyView);

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag;
      if (!tag) return;
      const nowActive = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', nowActive ? 'true' : 'false');
      if (nowActive) activeTags.add(tag); else activeTags.delete(tag);
      applyView();
    });
  });

  clearBtn?.addEventListener('click', () => {
    activeTags.clear();
    tagButtons.forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
    applyView();
  });

  applyView();
</script>
