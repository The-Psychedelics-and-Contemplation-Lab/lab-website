---
import { Layout, Section, MediaCard, SectionMark } from '@pcl/design-system';
import { getCollection } from 'astro:content';
import { site, navFor, projects } from '../site.config';
import { u } from '../lib/url';
import Marble from '../components/Marble.astro';
import PublicationItem from '../components/PublicationItem.astro';
import '../styles/site.css';

const latest = (await getCollection('publications')).map((e) => e.data).sort((a, b) => b.year - a.year || a.order - b.order).slice(0, 5);

/** Images for the project cards. StaMPS is a tool and the Montreal Model's only picture is a text-heavy
 *  schematic (unreadable under a card gradient, tried twice), so those two get the original site's
 *  flat panels — brand purple and olive — and only ReSPCT carries its illustration. */
const projectImages: Record<string, { src: string; alt: string }> = {
  'The ReSPCT Guidelines': { src: u('/images/respct-illustration-800.webp'), alt: 'Line illustration of a psychedelic dosing room: an armchair, a lamp, a plant and a window, drawn in one continuous stroke.' },
};
const projectClass: Record<string, string> = { 'StaMPS Data Framework': 'project-card--purple', 'The Montreal Model': 'project-card--olive' };
---
<Layout site={site} page={{ title: 'The Psychedelics & Contemplation Lab — McGill University, Montréal', description: 'A multidisciplinary lab at McGill University and the Lady Davis Institute exploring non-ordinary states of consciousness, spiritual practices and novel clinical interventions.', path: '/', bodyClass: 'home' }} nav={navFor('/')}>
  <main id="main">
    {/* The original home page: the purple marbled texture filling the viewport, the lab name huge, bottom-left. */}
    <div class="hero hero--marble marble">
      <Marble parallax={0.12} />
      <div class="hero__inner">
        <p class="eyebrow hero__eyebrow reveal reveal--fade">McGill University · Lady Davis Institute</p>
        <h1 class="reveal" style="--reveal-delay: 80ms">The Psychedelics &amp; Contemplation Lab</h1>
        <p class="lead reveal" style="--reveal-delay: 160ms">The Psychedelics and Contemplation Lab is a collaborative, multidisciplinary space dedicated to exploring the phenomenology of non-ordinary states of consciousness, spiritual practices, and novel clinical interventions.</p>
        <div class="cluster reveal" style="--reveal-delay: 240ms">
          <a class="btn btn--primary" href={u('/research/')}>Our research</a>
          <a class="btn btn--secondary" href={u('/people/')}>People</a>
        </div>
      </div>
    </div>

    <Section ariaLabelledby="projects-h">
      <SectionMark label="Projects" accent />
      <div class="home-section__head reveal">
        <h2 id="projects-h">Projects</h2>
        <p class="muted sans">Three initiatives of the lab with their own websites.</p>
      </div>
      <div class="grid grid--3 reveal-group">
        {projects.map((p) => (
          <MediaCard href={p.href} external eyebrow={p.eyebrow} title={p.name} text={p.description} src={projectImages[p.name]?.src} alt={projectImages[p.name]?.alt} class={`project-card ${projectClass[p.name] ?? 'project-card--image'}`} />
        ))}
      </div>
    </Section>

    <Section band tight ariaLabelledby="latest-h">
      <SectionMark label="Research output" />
      <div class="home-section__head reveal">
        <h2 id="latest-h">Latest publications</h2>
      </div>
      <ul class="pub-list reveal-group">
        {latest.map((pub) => <PublicationItem pub={pub} />)}
      </ul>
      <p class="home-section__more reveal"><a class="btn btn--quiet" href={u('/publications/')}>All publications →</a></p>
    </Section>
  </main>
</Layout>
