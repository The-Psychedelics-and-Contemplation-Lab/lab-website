---
/**
 * <Marble parallax? origin? max? position?> — the two background layers of a marbled box (the lab's
 * dithered purple/olive texture under a translucent colour veil). Put it first inside an element that
 * has class="marble" (and "marble--deep" for the darker inner-page bands, "marble--olive" for the
 * contemplative strand's green tint); the content follows.
 * `parallax` is the design-system speed (negative = faster than the page), `origin="top"` measures from
 * the layer's natural top (for heroes that start in view), `max` the pixel clamp.
 * The texture itself is a single shared data: URI, set once as --marble-tex / --marble-tex-small in
 * site.css, so every instance of this component stays tiny.
 */
export interface Props { parallax?: number | false; origin?: 'top'; max?: number; position?: string }
const { parallax = 0.12, origin, max, position } = Astro.props;
const style = position ? `--marble-pos:${position}` : undefined;
---
<div class="marble__img" style={style} data-parallax={parallax === false ? undefined : String(parallax)} data-parallax-origin={parallax === false ? undefined : origin} data-parallax-max={parallax === false || max === undefined ? undefined : String(max)} aria-hidden="true"></div>
<div class="marble__veil" aria-hidden="true"></div>
