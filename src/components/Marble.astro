---
/**
 * <Marble deep? parallax? position?> — the two background layers of a marbled box (the original site's
 * purple oil-slick texture under a translucent purple veil). Put it first inside an element that has
 * class="marble" (and "marble--deep" for the darker inner-page bands); the content follows.
 * The texture is served from public/images (1920 px ≤ 300 KB; 960 px under 60em).
 */
import { u } from '../lib/url';
export interface Props { parallax?: number | false; position?: string }
const { parallax = 0.12, position } = Astro.props;
const style = `--marble-url:url(${u('/images/marble-1920.webp')});--marble-url-small:url(${u('/images/marble-960.webp')})${position ? `;--marble-pos:${position}` : ''}`;
---
<div class="marble__img" style={style} data-parallax={parallax === false ? undefined : String(parallax)} aria-hidden="true"></div>
<div class="marble__veil" aria-hidden="true"></div>
