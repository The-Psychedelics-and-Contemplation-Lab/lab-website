---
import { Layout } from '@pcl/design-system';
import { getCollection } from 'astro:content';
import { site, navFor } from '../../site.config';
import { u } from '../../lib/url';
import '../../styles/site.css';
const research = await getCollection('research');
const strands = [
  { slug: 'psychedelic', title: 'Psychedelic research', path: '/psychedelic-research/', panelClass: 'research-split__psychedelics' },
  { slug: 'contemplative', title: 'Contemplative research', path: '/contemplative-research/', panelClass: 'research-split__contemplation' },
].map((s) => ({ ...s, entry: research.find((r) => r.id === s.slug)! }));
// --marble-url / --marble-url-small set inline, the same way <Marble> does, so the split panels
// can use the marble texture without the parallax/veil/grain layers that <Marble> also renders.
const marbleStyle = `--marble-url:url(${u('/images/marble-1920.webp')});--marble-url-small:url(${u('/images/marble-960.webp')})`;
---
<Layout site={site} page={{ title: 'Research — The Psychedelics & Contemplation Lab', description: 'Two strands of research at the lab: psychedelic research (ketamine, psilocybin, music, methods) and contemplative research (meditation, prayer, imagination, nature).', path: '/research/' }} nav={navFor('/research/')}>
  <main id="main">
    <div class="research-split">
      <h1 class="research-split__title">
        <span class="word-left">Psychedelics</span>
        <span class="ampersand">&amp;</span>
        <span class="word-right">Contemplation</span>
      </h1>
      {strands.map((s) => (
        <div class={s.panelClass} style={marbleStyle}>
          <div class="research-split__content">
            <h2>{s.title}</h2>
            <p>{s.entry.data.lead}</p>
            {s.entry.data.sections.map((sec) => (
              <a class="research-theme-card" href={u(`${s.path}#${sec.id}`)}>{sec.label}</a>
            ))}
            <p><a class="btn btn--secondary" href={u(s.path)}>All {s.entry.data.title.toLowerCase()}</a></p>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
