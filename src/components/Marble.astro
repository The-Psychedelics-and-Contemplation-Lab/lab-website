---
/**
 * <Marble parallax? origin? max? position?> — the two background layers of a marbled box (the original
 * site's purple oil-slick texture under a translucent purple veil). Put it first inside an element that
 * has class="marble" (and "marble--deep" for the darker inner-page bands); the content follows.
 * `parallax` is the design-system speed (negative = faster than the page), `origin="top"` measures from
 * the layer's natural top (for heroes that start in view), `max` the pixel clamp.
 * The texture is served from public/images (1920 px ≤ 300 KB; 960 px under 60em).
 */
import { u } from '../lib/url';
export interface Props { parallax?: number | false; origin?: 'top'; max?: number; position?: string; image?: string; live?: boolean }
const { parallax = 0.12, origin, max, position, image, live = false } = Astro.props;
const style = `--marble-url:url(${u(image ?? '/images/marble-1920.webp')});--marble-url-small:url(${u(image ?? '/images/marble-960.webp')})${position ? `;--marble-pos:${position}` : ''}`;
---
<div class:list={["marble__img", { "marble__img--live": live }]} style={style} data-parallax={parallax === false ? undefined : String(parallax)} data-parallax-origin={parallax === false ? undefined : origin} data-parallax-max={parallax === false || max === undefined ? undefined : String(max)} aria-hidden="true">{live && <div class="marble__tex" data-mouse-depth="-0.55" aria-hidden="true"></div>}</div>
<div class="marble__veil" aria-hidden="true"></div>
<div class="marble__grain" aria-hidden="true"></div>
