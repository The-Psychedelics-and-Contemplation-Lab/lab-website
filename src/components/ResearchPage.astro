---
/** Renders one entry of the `research` collection as a long-form page: marbled header band with the
 *  "← Back to all research" link and the category tab row (as on the original site), then the content. */
import { Layout, Section, Figure } from '@pcl/design-system';
import { getEntry, render } from 'astro:content';
import { site, navFor } from '../site.config';
import { u } from '../lib/url';
import BandHeader from './BandHeader.astro';
import '../styles/site.css';
export interface Props { slug: string; path: string }
const { slug, path } = Astro.props;
const entry = (await getEntry('research', slug))!;
const { Content } = await render(entry);
const d = entry.data;
---
<Layout site={site} page={{ title: `${d.title} — The Psychedelics & Contemplation Lab`, description: d.description, path }} nav={navFor(path)}>
  <main id="main">
    <BandHeader eyebrow={d.eyebrow} title={d.title} back={u('/research/')} backLabel="← Back to all research" tabs>
      <nav aria-label="Categories of this page">
        <ul class="tab-row reveal-group" role="tablist">
          {d.sections.map((s, i) => (
            <li role="presentation">
              <button type="button" class={i === 0 ? 'is-current' : undefined} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={s.id}>{s.label}</button>
            </li>
          ))}
        </ul>
      </nav>
    </BandHeader>
    <Section watermark="rings" watermarkPosition="left" watermarkInk>
      {d.image && (
        <Figure src={u(d.image)} alt={d.imageAlt ?? ''} caption={d.imageCaption} ratio={d.imageRatio} drift={d.imageRatio !== 'cinema'} loading="eager" class="reveal reveal--mask research-figure" />
      )}
      {d.pullquote && (
        <blockquote class="pullquote pullquote--epigraph reveal reveal--rise-lg">
          {d.pullquote}
          {d.pullquoteCite && <cite>{d.pullquoteCite}</cite>}
        </blockquote>
      )}
      <div class="container--reading">
        <div class="prose research-prose"><Content /></div>
        <p style="margin-top: var(--s-12)"><a class="btn btn--quiet" href={u('/research/')}>← Back to all research</a></p>
      </div>
    </Section>
  </main>
</Layout>

<script>
  // The tab row used to be a set of in-page anchors, with the "active" tab highlighted as you scrolled
  // past its heading. It's now a real tab control: clicking a tab shows that theme's content in a panel
  // and hides the rest, with no scrolling or page jump. Switching is instant (no animation).
  //
  // The content itself is still one flowing block rendered from markdown (each theme is just an
  // <h2 id="..."> followed by its prose), so on load we group the rendered content into one panel per
  // heading, then toggle which panel is visible.
  const prose = document.querySelector<HTMLElement>('.research-prose');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab-row button[data-tab]')];

  if (prose && tabs.length) {
    const panels = new Map<string, HTMLDivElement>();
    let current: HTMLDivElement | null = null;
    [...prose.children].forEach((el) => {
      if (el.tagName === 'H2' && el.id) {
        current = document.createElement('div');
        current.className = 'tab-panel';
        current.dataset.panel = el.id;
        current.setAttribute('role', 'tabpanel');
        panels.set(el.id, current);
      }
      current?.appendChild(el);
    });
    panels.forEach((panel) => prose.appendChild(panel));

    const show = (id: string) => {
      panels.forEach((panel, panelId) => { panel.hidden = panelId !== id; });
      tabs.forEach((btn) => {
        const active = btn.dataset.tab === id;
        btn.classList.toggle('is-current', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    tabs.forEach((btn) => btn.addEventListener('click', () => { if (btn.dataset.tab) show(btn.dataset.tab); }));
    if (tabs[0]?.dataset.tab) show(tabs[0].dataset.tab);
  }
</script>
