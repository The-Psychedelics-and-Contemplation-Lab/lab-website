---
/** Renders one entry of the `research` collection as a long-form page: marbled header band with the
 *  "← Back to all research" link and the category tab row (as on the original site), then the content. */
import { Layout, Section, Figure } from '@pcl/design-system';
import { getEntry, render } from 'astro:content';
import { site, navFor } from '../site.config';
import { u } from '../lib/url';
import BandHeader from './BandHeader.astro';
import '../styles/site.css';
export interface Props { slug: string; path: string }
const { slug, path } = Astro.props;
const entry = (await getEntry('research', slug))!;
const { Content } = await render(entry);
const d = entry.data;
---
<Layout site={site} page={{ title: `${d.title} — The Psychedelics & Contemplation Lab`, description: d.description, path }} nav={navFor(path)}>
  <main id="main">
    <BandHeader eyebrow={d.eyebrow} title={d.title} lead={d.lead} back={u('/research/')} backLabel="← Back to all research" tabs>
      <nav aria-label="Categories of this page">
        <ul class="tab-row reveal-group">
          {d.sections.map((s, i) => <li><a href={`#${s.id}`} class={i === 0 ? 'is-current' : undefined}>{s.label}</a></li>)}
        </ul>
      </nav>
    </BandHeader>
    <Section watermark="rings" watermarkPosition="left" watermarkInk>
      {d.image && (
        <Figure src={u(d.image)} alt={d.imageAlt ?? ''} caption={d.imageCaption} ratio={d.imageRatio} drift={d.imageRatio !== 'cinema'} loading="eager" class="reveal reveal--mask research-figure" />
      )}
      {d.pullquote && (
        <blockquote class="pullquote pullquote--epigraph reveal reveal--rise-lg">
          {d.pullquote}
          {d.pullquoteCite && <cite>{d.pullquoteCite}</cite>}
        </blockquote>
      )}
      <div class="container--reading">
        <div class="prose research-prose"><Content /></div>
        <p style="margin-top: var(--s-12)"><a class="btn btn--quiet" href={u('/research/')}>← Back to all research</a></p>
      </div>
    </Section>
  </main>
</Layout>

<script>
  // The tab row highlights the category currently on screen (the original's "active" tab button).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tab-row a[href^="#"]')];
  const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter((el): el is HTMLElement => !!el);
  if (links.length && targets.length && 'IntersectionObserver' in window) {
    const set = (id: string) => links.forEach((a) => a.classList.toggle('is-current', a.hash === `#${id}`));
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) set(visible[0].target.id);
    }, { rootMargin: '-20% 0px -60% 0px' });
    targets.forEach((t) => io.observe(t));
    links.forEach((a) => a.addEventListener('click', () => set(a.hash.slice(1))));
  }
</script>
