---
import { Layout, Section } from '@pcl/design-system';
import BandHeader from '../../components/BandHeader.astro';
import { getEntry, render } from 'astro:content';
import { site, navFor } from '../../site.config';
import '../../styles/site.css';
const entry = (await getEntry('pages', 'media'))!;
const { Content } = await render(entry);
const d = entry.data;
---
<Layout site={site} page={{ title: `${d.title} — The Psychedelics & Contemplation Lab`, description: d.description, path: '/media/' }} nav={navFor('/media/')}>
  <main id="main">
    <BandHeader eyebrow={d.eyebrow} title={d.title} />
    <Section><div class="prose prose--centered"><Content /></div></Section>
  </main>
</Layout>
